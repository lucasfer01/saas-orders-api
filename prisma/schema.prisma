generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrderStatus {
  DRAFT
  OPEN
  PAID
  CANCELED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentProvider {
  MOCK
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users        User[]
  roles        Role[]
  products     Product[]
  orders       Order[]
  outboxEvents OutboxEvent[]
  payments     Payment[]
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles         UserRole[]
  refreshTokens RefreshToken[]

  orderStatusChanges OrderStatusHistory[] @relation("OrderStatusChangedBy")

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
}

model Role {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Product {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  priceCents Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  OrderItem[]

  @@index([tenantId])
  @@index([active])
}

model Order {
  id       String      @id @default(cuid())
  tenantId String
  number   Int
  status   OrderStatus @default(DRAFT)

  subtotalCents Int @default(0)
  totalCents    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  payments Payment[]
  receipt  Receipt?

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([createdAt])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  tenantId String

  productId      String
  productName    String
  qty            Int
  unitPriceCents Int
  lineTotalCents Int

  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([tenantId])
  @@index([productId])
}

model OrderStatusHistory {
  id       String @id @default(cuid())
  orderId  String
  tenantId String

  fromStatus OrderStatus?
  toStatus   OrderStatus

  changedByUserId String
  createdAt       DateTime @default(now())

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User  @relation("OrderStatusChangedBy", fields: [changedByUserId], references: [id])

  @@index([orderId])
  @@index([tenantId])
  @@index([createdAt])
}

model Payment {
  id             String          @id @default(cuid())
  tenantId       String
  orderId        String
  provider       PaymentProvider @default(MOCK)
  status         PaymentStatus   @default(PENDING)
  amountCents    Int
  idempotencyKey String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  method         PaymentMethod

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model OutboxEvent {
  id          String       @id @default(cuid())
  tenantId    String
  type        String
  payloadJson Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  nextRunAt   DateTime?
  createdAt   DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ReceiptStatus {
  ISSUED
  VOIDED
}

model Receipt {
  id            String         @id @default(cuid())
  tenantId      String
  orderId       String   @unique
  number        Int
  status        ReceiptStatus  @default(ISSUED)
  currency      String         @default("USD")
  subtotalCents Int
  taxCents      Int            @default(0)
  totalCents    Int
  issuedAt      DateTime       @default(now())
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items         ReceiptItem[]
  order         Order?         @relation(fields: [orderId], references: [id])

  @@unique([tenantId, orderId])
  @@unique([tenantId, number])
  @@index([tenantId, issuedAt])
}

model ReceiptItem {
  id             String   @id @default(cuid())
  tenantId       String
  receiptId      String
  productId      String?
  name           String
  unitPriceCents Int
  qty            Int
  lineTotalCents Int
  createdAt      DateTime @default(now())

  receipt        Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([tenantId, receiptId])
}

model TenantCounter {
  tenantId String
  key      String
  value    Int     @default(0)

  @@unique([tenantId, key])
}
