generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentProvider {
  MOCK
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users        User[]
  roles        Role[]
  products     Product[]
  orders       Order[]
  outboxEvents OutboxEvent[]
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
}

model Role {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Product {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  priceCents Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  OrderItem[]

  @@index([tenantId])
  @@index([active])
}

model Order {
  id           String      @id @default(cuid())
  tenantId     String
  customerName String
  status       OrderStatus @default(DRAFT)
  totalCents   Int         @default(0)
  createdAt    DateTime    @default(now())

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payments Payment[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  qty            Int
  unitPriceCents Int
  lineTotalCents Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id             String          @id @default(cuid())
  orderId        String
  provider       PaymentProvider @default(MOCK)
  status         PaymentStatus   @default(PENDING)
  amountCents    Int
  idempotencyKey String
  createdAt      DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, idempotencyKey])
  @@index([status])
  @@index([createdAt])
}

model OutboxEvent {
  id          String       @id @default(cuid())
  tenantId    String
  type        String
  payloadJson Json
  status      OutboxStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
